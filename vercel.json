{
  "version": 2,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.2",
      "memory": 256,
      "maxDuration": 15,
      "includeFiles": "config.php,index.php,includes/**,data/**,views/**,scripts/**"
    }
  },
  "routes": [
    {
      "src": "/assets/js/(.*)",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      },
      "dest": "/assets/js/$1"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400"
      },
      "dest": "/assets/$1"
    },
    {
      "src": "/img/(.*)",
      "headers": {
        "cache-control": "public, max-age=604800, s-maxage=2592000, stale-while-revalidate=86400"
      },
      "dest": "/img/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "https://twinsjasdor.my.id/uploads/$1"
    },
    {
      "src": "/api/config",
      "dest": "/api/config.php"
    },
    {
      "src": "/api/health",
      "dest": "/api/health.php"
    },
    {
      "src": "/api/sync_status",
      "dest": "/api/sync_status.php"
    },
    {
      "src": "/api/sync/status",
      "dest": "/api/sync_status.php"
    },
    {
      "src": "/api/cron_sync",
      "dest": "/api/cron_sync.php"
    },
    {
      "src": "/api/cron/sync",
      "dest": "/api/cron_sync.php"
    },
    {
      "src": "/api/menu/options",
      "dest": "/api/item.php"
    },
    {
      "src": "/api/([a-zA-Z0-9_-]+)/outlets",
      "dest": "/api/outlets.php?brand=$1"
    },
    {
      "src": "/api/([a-zA-Z0-9_-]+)/menu",
      "dest": "/api/menu.php?brand=$1"
    },
    {
      "src": "/api/([a-zA-Z0-9_-]+)/products",
      "dest": "/api/menu.php?brand=$1"
    },
    {
      "src": "/api/([a-zA-Z0-9_-]+)/item",
      "dest": "/api/item.php?brand=$1"
    },
    {
      "src": "/api/orders",
      "dest": "/api/order.php"
    },
    {
      "src": "/api/order",
      "dest": "/api/order.php"
    },
    {
      "src": "/api/track",
      "dest": "/api/track.php"
    },
    {
      "src": "/(kopikenangan|tomoro|fore|janjiw|janjijiwa|jiwa)",
      "dest": "/api/index.php?brand=$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}