{
  "version": 2,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.2",
      "memory": 256,
      "maxDuration": 15,
      "includeFiles": "config.php,index.php,includes/**,data/**,views/**,scripts/**"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, s-maxage=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/img/(.*)",
      "dest": "/img/$1"
    },
    {
      "src": "/api/config",
      "dest": "/api/config.php"
    },
    {
      "src": "/api/health",
      "dest": "/api/health.php"
    },
    {
      "src": "/api/sync_status",
      "dest": "/api/sync_status.php"
    },
    {
      "src": "/api/sync/status",
      "dest": "/api/sync_status.php"
    },
    {
      "src": "/api/cron_sync",
      "dest": "/api/cron_sync.php"
    },
    {
      "src": "/api/cron/sync",
      "dest": "/api/cron_sync.php"
    },
    {
      "src": "/api/([a-zA-Z0-9_-]+)/outlets",
      "dest": "/api/outlets.php?brand=$1"
    },
    {
      "src": "/api/([a-zA-Z0-9_-]+)/menu",
      "dest": "/api/menu.php?brand=$1"
    },
    {
      "src": "/api/([a-zA-Z0-9_-]+)/item",
      "dest": "/api/item.php?brand=$1"
    },
    {
      "src": "/api/orders",
      "dest": "/api/order.php"
    },
    {
      "src": "/api/order",
      "dest": "/api/order.php"
    },
    {
      "src": "/api/track",
      "dest": "/api/track.php"
    },
    {
      "src": "/(kopikenangan|tomoro|fore|janjiw|janjijiwa|jiwa|point|pointcoffee)",
      "dest": "/api/index.php?brand=$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
